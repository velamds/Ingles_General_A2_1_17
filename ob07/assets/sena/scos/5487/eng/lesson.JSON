data": [], "type": "audio", "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn4le17ob07re2aud01", "coverimg": "engenn4le17ob07re2img01.jpg", "images": [{"image": "engenn4le17ob07re2img01.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn4le17ob07re2img05.jpg", "text": "<span class=\"strong\">John</span>: I'm excited to be here! I love going to the casino. Don't you, Jasmine?<br>\n<span class=\"strong\">Jasmine</span>: Hmm, I'm not much of a gambler, but I heard that they have good restaurants here.<br>\n<span class=\"strong\">John</span>: Restaurants? I'm here to win some money! I'm going to play some poker.", "id": 1, "time": "1"}, {"image": "engenn4le17ob07re2img01.jpg", "text": "<span class=\"strong\">Jasmine</span>: Good luck with that! I'm going to do some shopping. I think there are some good stores here.<br>\n<span class=\"strong\">John</span>: Time to spend those tips, eh?<br>\n<span class=\"strong\">Jasmine</span>: Call me if you want to meet for dinner.", "id": 2, "time": "18000"}, {"image": "engenn4le17ob07re2img02.jpg", "text": "<span class=\"strong\">John</span>: Sounds good. Do you have your two-way with you?<br>\n<span class=\"strong\">Jasmine</span>: Of course! If you want to meet up earlier, let me know.", "id": 3, "time": "30000"}, {"image": "engenn4le17ob07re2img02.jpg", "text": "<span class=\"strong\">John</span>: If I win big, dinner is on me. <br>\n<span class=\"strong\">Jasmine</span>: Roger that! Did you bring your lucky hat?<br>\n<span class=\"strong\">John</span>: Of course ... I don't go to a casino without it.", "id": 4, "time": "38000"}]}}], "id": 1}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "John in Argentina", "type": "lesson_name"}, {"content": "A Night at the Casino", "type": "unit_name"}, {"content": 7, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 17, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about directions to places in a limited range of social situations.", "type": "primary"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_1"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_2"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_3"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_4"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_5"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_6"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_7"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "The Zero Conditional", "type": "heading"}, {"content": "You use the zero conditional to talk about general truths and certainties and to give instructions.", "type": "describer"}, {"content": "There are two parts to the sentence.<br> One part is the <span class=\"strong\">condition</span>. The other part is the <span class=\"strong\">result</span>.", "type": "text"}, {"content": "Form:<br>if  or when + subject + the Simple Present tense", "type": "text"}, {"content": "You can flip the two parts of the sentence so that the result comes first.", "type": "text"}, {"content": "Subject + The Simple Present tense/Imperative + if or when + subject + the Simple Present"