\\\": \\\"text\\\", \\\"content\\\": \\\"\\\"}\",\"{\\\"type\\\": \\\"image\\\", \\\"content\\\": \\\"engenn4le17ob06img06.jpg\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a moose\\\"}\",\"{\\\"type\\\": \\\"image\\\", \\\"content\\\": \\\"engenn4le17ob06img07.jpg\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a panther\\\"}\",\"{\\\"type\\\": \\\"image\\\", \\\"content\\\": \\\"engenn4le17ob06img08.jpg\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"cardiinals\\\"}\",\"{\\\"type\\\": \\\"image\\\", \\\"content\\\": \\\"engenn4le17ob06img09.jpg\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a nest with eggs\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}]}, {"type": "learning_points", "contents": [{"content": " What Are Idioms?", "type": "heading"}, {"content": " Idioms are expressions which have a meaning apart from what the words themselves mean.", "type": "describer"}, {"content": "They are very common in spoken English. It is important to know some idioms and to remember that the meaning of the words as a group is different from the words individually.", "type": "text"}, {"content": "Here are some idioms:", "type": "text"}, {"content": "{\"rows\":6,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\"> Idiom </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\"> Meaning </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Keep an eye out for ... \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Watch for ... \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It cost an arm and a leg. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's very expensive .\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"That is a piece of cake. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"That is very easy.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It happens once in a blue moon. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It happens very rarely. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It takes two to tango.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You need more than one person to do something.\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": "stream ", "type": "name"}, {"content": "a small, narrow river ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Tigre sits on an island created by rivers and streams.", "type": "example"}, {"content": "engenn4le17ob06aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you hear on a tour.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "field glasses ", "type": "name"}, {"content": "binoculars for outdoor use ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Don't forget to bring your field glasses.", "type": "example"}, {"content": "engenn4le17ob06aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "mahogany ", "type": "name"}, {"content": "a heavy, dark wood ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We are taking a mahogany boat through the rivers.", "type": "example"}, {"content": "engenn4le17ob06aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "vintage ", "type": "name"}, {"content": "more than 20 years old ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The boat is vintage mahogany.", "type": "example"}, {"content": "engenn4le17ob06aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "web ", "type": "name"}, {"content": "a system of connected river